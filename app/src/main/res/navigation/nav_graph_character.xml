<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_character"
    app:startDestination="@id/characterListFragment">

    <fragment
        android:id="@+id/characterListFragment"
        android:name="com.murkfeatherstudio.questroll.feature_character.ui.list.CharacterListFragment"
        android:label="Character List">
        <action
            android:id="@+id/action_to_creator"
            app:destination="@id/characterCreatorFragment" />
        <action
            android:id="@+id/action_to_sheet"
            app:destination="@id/characterSheetFragment" />
    </fragment>

    <fragment
        android:id="@+id/characterCreatorFragment"
        android:name="com.murkfeatherstudio.questroll.feature_character.ui.creator.CharacterCreatorFragment"
        android:label="Character Creator">
        <action
            android:id="@+id/action_creator_to_sheet"
            app:destination="@id/characterSheetFragment" />
    </fragment>

    <fragment
        android:id="@+id/characterSheetFragment"
        android:name="com.murkfeatherstudio.questroll.feature_character.ui.sheet.CharacterSheetFragment"
        android:label="Character Sheet">
        <argument
            android:name="character_id"
            app:argType="long" />
    </fragment>

</navigation>