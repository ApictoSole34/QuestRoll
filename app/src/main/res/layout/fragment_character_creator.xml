<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Character name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="?attr/colorOnSurfaceVariant"
            app:boxStrokeColor="?attr/colorOutline">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/character_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/inter_regular" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alignment"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/alignment_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Background"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/background_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Species"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/species_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classes (multiclass)"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/add_class_button"
            style="@style/QuestRollButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add class"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/class_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attribute generation"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/attr_method_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radio_standard"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radio_roll"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll 4d6" />

            <RadioButton
                android:id="@+id/radio_point_buy"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point buy" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/attributes_static_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/attributes_pointbuy_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <Button
            android:id="@+id/save_button"
            style="@style/QuestRollButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save character"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>