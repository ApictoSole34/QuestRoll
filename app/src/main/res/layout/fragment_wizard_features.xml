<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/QuestRollSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class Features"
        android:layout_marginBottom="12dp" />

    <TextView
        style="@style/QuestRollCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add features like Spellcasting, Fighting Style, etc."
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_add_feature"
        style="@style/QuestRollButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add Feature"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_features"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="false" />

</LinearLayout>