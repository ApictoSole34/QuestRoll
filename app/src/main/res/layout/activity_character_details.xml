<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/imageViewCharacter"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <TextView
                android:id="@+id/textViewName"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Name: " />

            <TextView
                android:id="@+id/textViewRace"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Race: " />

            <TextView
                android:id="@+id/textViewClass"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Class: " />

            <TextView
                android:id="@+id/textViewLevel"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Level: " />

            <TextView
                android:id="@+id/textViewStrength"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Strength: " />

            <TextView
                android:id="@+id/textViewDexterity"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Dexterity: " />

            <TextView
                android:id="@+id/textViewConstitution"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Constitution: " />

            <TextView
                android:id="@+id/textViewIntelligence"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Intelligence: " />

            <TextView
                android:id="@+id/textViewWisdom"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Wisdom: " />

            <TextView
                android:id="@+id/textViewCharisma"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Charisma: " />

            <TextView
                android:id="@+id/textViewGameVersion"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/buttonManage"
        style="@style/QuestRollButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Manage" />

</LinearLayout>