<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/QuestRollSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Basic Info"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Spell Name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSpellName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:inputType="textCapWords"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Spell Level"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <Spinner
                    android:id="@+id/spinnerLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="School of Magic"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="?attr/colorOnSurfaceVariant"
                    app:boxStrokeColor="?attr/colorOutline">
                    <AutoCompleteTextView
                        android:id="@+id/actvSchool"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:focusable="false"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCustomSchool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ School"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="?attr/colorPrimary"/>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Description"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSpellDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:maxLines="10"
                    android:gravity="top"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/QuestRollSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Casting"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Casting Time"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <AutoCompleteTextView
                    android:id="@+id/actvCastingTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Range"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRangeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Duration"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/QuestRollSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Components"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <CheckBox
                    android:id="@+id/cbVerbal"
                    style="@style/QuestRollBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Verbal (V)"/>

                <CheckBox
                    android:id="@+id/cbSomatic"
                    style="@style/QuestRollBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Somatic (S)"/>

                <CheckBox
                    android:id="@+id/cbMaterial"
                    style="@style/QuestRollBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Material (M)"/>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMaterialSpecified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Material component description"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMaterialSpecified"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="2"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <CheckBox
                    android:id="@+id/cbRitual"
                    style="@style/QuestRollBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ritual"/>

                <CheckBox
                    android:id="@+id/cbConcentration"
                    style="@style/QuestRollBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Concentration"/>
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/QuestRollSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Damage"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Damage Roll (e.g. 2d6)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDamageRoll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cbAttackRoll"
                style="@style/QuestRollBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Requires Attack Roll"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Saving Throw"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <AutoCompleteTextView
                    android:id="@+id/actvSavingThrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:focusable="false"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/QuestRollLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Damage Types"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDamageTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <TextView
                style="@style/QuestRollSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="At Higher Levels"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="At Higher Levels description"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintTextColor="?attr/colorOnSurfaceVariant"
                app:boxStrokeColor="?attr/colorOutline">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHigherLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="6"
                    android:gravity="top"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    style="@style/QuestRollSectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scaling Options"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCastingOption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="?attr/colorPrimary"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCastingOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSpell"
                style="@style/QuestRollButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Spell"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>