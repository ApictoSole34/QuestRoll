<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/QuestRollHeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMPENDIUM"
            android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/menu_classes" style="@style/QuestRollMenuItem" android:text="Classes"/>
        <TextView android:id="@+id/menu_spells" style="@style/QuestRollMenuItem" android:text="Spells"/>
        <TextView android:id="@+id/menu_creatures" style="@style/QuestRollMenuItem" android:text="Creatures"/>
        <TextView android:id="@+id/menu_creature_types" style="@style/QuestRollMenuItem" android:text="Creature Types"/>
        <TextView android:id="@+id/menu_species" style="@style/QuestRollMenuItem" android:text="Species"/>
        <TextView android:id="@+id/menu_backgrounds" style="@style/QuestRollMenuItem" android:text="Backgrounds"/>
        <TextView android:id="@+id/menu_languages" style="@style/QuestRollMenuItem" android:text="Languages"/>
        <TextView android:id="@+id/menu_abilities" style="@style/QuestRollMenuItem" android:text="Abilities"/>
        <TextView android:id="@+id/menu_alignments" style="@style/QuestRollMenuItem" android:text="Alignments"/>
        <TextView android:id="@+id/menu_conditions" style="@style/QuestRollMenuItem" android:text="Conditions"/>
        <TextView android:id="@+id/menu_environments" style="@style/QuestRollMenuItem" android:text="Environments"/>
        <TextView android:id="@+id/menu_rulesets" style="@style/QuestRollMenuItem" android:text="Rulesets"/>
        <TextView android:id="@+id/menu_services" style="@style/QuestRollMenuItem" android:text="Services"/>
        <TextView android:id="@+id/menu_items" style="@style/QuestRollMenuItem" android:text="Items"/>
        <TextView android:id="@+id/menu_item_sets" style="@style/QuestRollMenuItem" android:text="Item Sets"/>
        <TextView android:id="@+id/menu_item_rarities" style="@style/QuestRollMenuItem" android:text="Item Rarities"/>
        <TextView android:id="@+id/menu_weapon_properties" style="@style/QuestRollMenuItem" android:text="Weapon Properties"/>
        <TextView android:id="@+id/menu_damage_types" style="@style/QuestRollMenuItem" android:text="Damage Types"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginVertical="16dp"/>

        <TextView android:id="@+id/menu_pdf" style="@style/QuestRollMenuItem" android:text="PDF Manuals"/>

    </LinearLayout>
</ScrollView>