<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_character_name"
        style="@style/QuestRollTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_character_info"
        style="@style/QuestRollBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_change_character"
        style="@style/QuestRollButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Character"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_open_character"
        style="@style/QuestRollButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Character Sheet"
        android:layout_marginTop="8dp" />

</LinearLayout>