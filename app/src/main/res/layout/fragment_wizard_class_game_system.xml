<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_game_system_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game System"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_game_system_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.7"
            android:text="Which ruleset this class belongs to. If you mark this class as a subclass on the next step, this will automatically switch to match the parent class."
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinner_game_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>