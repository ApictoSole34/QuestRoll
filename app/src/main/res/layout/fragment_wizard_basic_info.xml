<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Basic Info"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Class Name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="?attr/colorOnSurfaceVariant"
            app:boxStrokeColor="?attr/colorOutline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_class_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description (optional)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="?attr/colorOnSurfaceVariant"
            app:boxStrokeColor="?attr/colorOutline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="6"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hit Dice"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_hit_dice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caster Type"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_caster_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spellcasting Ability"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_spellcasting_ability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Multiclass Prerequisites -->
        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Multiclass Prerequisites"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minimum ability scores required to enter or leave this class (default 13 for standard classes)."
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="16dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:layout_marginBottom="16dp">

            <!-- STR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">
                <CheckBox android:id="@+id/cb_req_str" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STR"/>
                <EditText android:id="@+id/et_req_str_val" android:layout_width="50dp" android:layout_height="wrap_content" android:inputType="number" android:hint="13" android:enabled="false" android:text="13"/>
            </LinearLayout>

            <!-- DEX -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">
                <CheckBox android:id="@+id/cb_req_dex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEX"/>
                <EditText android:id="@+id/et_req_dex_val" android:layout_width="50dp" android:layout_height="wrap_content" android:inputType="number" android:hint="13" android:enabled="false" android:text="13"/>
            </LinearLayout>

            <!-- CON -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">
                <CheckBox android:id="@+id/cb_req_con" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CON"/>
                <EditText android:id="@+id/et_req_con_val" android:layout_width="50dp" android:layout_height="wrap_content" android:inputType="number" android:hint="13" android:enabled="false" android:text="13"/>
            </LinearLayout>

            <!-- INT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">
                <CheckBox android:id="@+id/cb_req_int" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INT"/>
                <EditText android:id="@+id/et_req_int_val" android:layout_width="50dp" android:layout_height="wrap_content" android:inputType="number" android:hint="13" android:enabled="false" android:text="13"/>
            </LinearLayout>

            <!-- WIS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">
                <CheckBox android:id="@+id/cb_req_wis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIS"/>
                <EditText android:id="@+id/et_req_wis_val" android:layout_width="50dp" android:layout_height="wrap_content" android:inputType="number" android:hint="13" android:enabled="false" android:text="13"/>
            </LinearLayout>

            <!-- CHA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">
                <CheckBox android:id="@+id/cb_req_cha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHA"/>
                <EditText android:id="@+id/et_req_cha_val" android:layout_width="50dp" android:layout_height="wrap_content" android:inputType="number" android:hint="13" android:enabled="false" android:text="13"/>
            </LinearLayout>

        </GridLayout>

    </LinearLayout>
</ScrollView>