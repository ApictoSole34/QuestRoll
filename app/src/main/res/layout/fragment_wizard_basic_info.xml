<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Basic Info"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Class Name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="?attr/colorOnSurfaceVariant"
            app:boxStrokeColor="?attr/colorOutline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_class_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description (optional)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="?attr/colorOnSurfaceVariant"
            app:boxStrokeColor="?attr/colorOutline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="6"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hit Dice"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_hit_dice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caster Type"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_caster_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spellcasting Ability"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_spellcasting_ability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>