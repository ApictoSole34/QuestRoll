<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/racial_bonus_text"
            style="@style/QuestRollBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:text="Racial bonuses: none"
            android:background="@color/threads_surface"
            android:visibility="visible" />

        <RadioGroup
            android:id="@+id/attr_method_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radio_standard"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard" />

            <RadioButton
                android:id="@+id/radio_roll"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll 4d6" />

            <RadioButton
                android:id="@+id/radio_point_buy"
                style="@style/QuestRollBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point buy" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/attributes_standard_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/attributes_pointbuy_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/remaining_points_text"
            style="@style/QuestRollBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Remaining points: 27"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/attributes_roll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/roll_button"
                style="@style/QuestRollButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll dice"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/roll_result_text"
                style="@style/QuestRollBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/threads_surface" />

            <Button
                android:id="@+id/apply_roll_button"
                style="@style/QuestRollButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm results"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/roll_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/back_button"
                style="@style/QuestRollButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Back"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/reset_button"
                style="@style/QuestRollButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:visibility="gone"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/next_button"
                style="@style/QuestRollButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Next"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>