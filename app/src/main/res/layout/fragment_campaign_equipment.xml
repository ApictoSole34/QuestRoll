<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/threads_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_no_character"
            style="@style/QuestRollBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No character assigned to this campaign."
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <!-- GOLD CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/threads_surface">

            <LinearLayout
                android:id="@+id/layout_gold_click"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/QuestRollBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💰 Current Gold"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_gold"
                    style="@style/QuestRollStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 gp"
                    android:textSize="22sp"
                    android:textColor="#F9A825" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- EQUIPPED SLOTS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/threads_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        style="@style/QuestRollSectionHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Equipped Slots" />

                    <TextView
                        android:id="@+id/tv_ac_value"
                        style="@style/QuestRollBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AC: —"
                        android:textStyle="bold"
                        android:textColor="@color/threads_gold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <!-- Armor -->
                    <LinearLayout android:id="@+id/row_slot_body" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Armor" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_body" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_body_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Main Hand -->
                    <LinearLayout android:id="@+id/row_slot_main_hand" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Main Hand" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_main_hand" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_main_hand_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Off Hand -->
                    <LinearLayout android:id="@+id/row_slot_off_hand" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Off Hand" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_off_hand" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_off_hand_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Head -->
                    <LinearLayout android:id="@+id/row_slot_head" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Head" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_head" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_head_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Neck -->
                    <LinearLayout android:id="@+id/row_slot_neck" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Neck" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_neck" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_neck_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Cloak -->
                    <LinearLayout android:id="@+id/row_slot_cloak" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Cloak" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_cloak" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_cloak_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Gloves -->
                    <LinearLayout android:id="@+id/row_slot_hands" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Gloves" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_hands" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_hands_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Ring L -->
                    <LinearLayout android:id="@+id/row_slot_ring_left" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Ring L" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_ring_left" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_ring_left_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Ring R -->
                    <LinearLayout android:id="@+id/row_slot_ring_right" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Ring R" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_ring_right" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_ring_right_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Waist -->
                    <LinearLayout android:id="@+id/row_slot_waist" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Waist" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_waist" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_waist_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>

                    <!-- Boots -->
                    <LinearLayout android:id="@+id/row_slot_feet" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView style="@style/QuestRollCaption" android:text="Boots" android:layout_width="90dp"/>
                        <TextView android:id="@+id/tv_slot_feet" style="@style/QuestRollBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="14sp"/>
                        <ImageButton android:id="@+id/btn_slot_feet_info" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_info_details" android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BACKPACK CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_backpack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/threads_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        style="@style/QuestRollSectionHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Backpack" />

                    <TextView
                        android:id="@+id/tv_total_weight"
                        style="@style/QuestRollCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Weight: 0 lb"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_add_item_inline"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add Item"
                        android:textColor="@color/threads_gold"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_inventory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tv_empty_inventory"
                    style="@style/QuestRollBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Backpack is empty."
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
