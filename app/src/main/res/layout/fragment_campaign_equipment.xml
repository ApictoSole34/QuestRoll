<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="80dp">

            <!-- NO CHARACTER placeholder -->
            <TextView
                android:id="@+id/tv_no_character"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No character assigned to this campaign."
                android:textSize="15sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />

            <!-- GOLD CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💰 Gold"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btn_gold_minus"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="−"
                        android:textSize="18sp"
                        android:minWidth="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp"
                        android:insetRight="0dp" android:insetBottom="0dp" />

                    <TextView
                        android:id="@+id/tv_gold"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="0 gp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#F9A825"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btn_gold_plus"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:minWidth="0dp"
                        android:insetLeft="0dp" android:insetTop="0dp"
                        android:insetRight="0dp" android:insetBottom="0dp" />

                    <Button
                        android:id="@+id/btn_gold_set"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EQUIPPED SLOTS CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Equipped"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_ac_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AC: —"
                            android:textSize="13sp"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Slot rows -->
                    <LinearLayout android:id="@+id/slot_main_hand" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="⚔ Main Hand" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_main_hand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_main_hand" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_off_hand" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="🛡 Off Hand" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_off_hand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_off_hand" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_body" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="🧥 Armor" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_body" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_head" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="⛑ Head" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_head" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_neck" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="📿 Neck" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_neck" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_neck" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_cloak" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="🌙 Cloak" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_cloak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_cloak" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_hands" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="🧤 Gloves" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_hands" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_hands" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_ring_left" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="💍 Ring L" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_ring_left" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_ring_left" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_ring_right" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="💍 Ring R" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_ring_right" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_ring_right" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_waist" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="👔 Waist" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_waist" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_waist" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

                    <LinearLayout android:id="@+id/slot_feet" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="👢 Boots" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/tv_slot_feet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textSize="13sp" android:paddingStart="8dp" />
                        <Button android:id="@+id/btn_unequip_feet" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:visibility="gone" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BACKPACK CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_backpack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Backpack"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_total_weight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 lb"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_carry_capacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / — lb"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_inventory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/tv_empty_inventory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Backpack is empty."
                        android:textSize="14sp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB: Open Shop -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_shop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add item"
        android:visibility="gone"
        app:layout_anchor="@id/fab_shop"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>