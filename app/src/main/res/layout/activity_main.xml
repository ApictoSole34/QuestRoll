        ```
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="72dp"
            android:paddingBottom="48dp">

            <!-- HERO -->

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="QuestRoll"
                android:textColor="#E8D7A8"
                android:textSize="42sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="Your D and D Companion"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <!-- MAIN ACTION -->

            <TextView
                android:id="@+id/openRollDiceButton"
                style="@style/QuestRollMenuItem"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:onClick="openRollDiceActivity"
                android:text="🎲 Roll Dice" />

            <!-- CORE SECTION -->

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <TextView
                    android:id="@+id/btnCharacters"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openCharacterListActivity"
                    android:text="Characters"/>

                <TextView
                    android:id="@+id/openCampaignListActivity2"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openCampaignListActivity"
                    android:text="Campaigns"/>

                <TextView
                    android:id="@+id/openClassListActivity"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openClassListActivity"
                    android:text="Classes"/>

                <TextView
                    android:id="@+id/openSpecies"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openSpeciesListActivity"
                    android:text="Species"/>

                <TextView
                    android:id="@+id/openSpellListActivity"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openSpellListActivity"
                    android:text="Spells"/>

                <TextView
                    android:id="@+id/openBackground"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openBackgroundListActivity"
                    android:text="Backgrounds"/>

                <TextView
                    android:id="@+id/openLanguageListActivity"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openLanguageListActivity"
                    android:text="Languages"/>

                <TextView
                    android:id="@+id/alignmentListActivity"
                    style="@style/QuestRollMenuItem"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:onClick="openAlignmentListActivity"
                    android:text="Alignments"/>

            </GridLayout>

            <!-- LIBRARY HEADER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="LIBRARY"
                android:textColor="#D4AF37"
                android:textStyle="bold"/>

            <!-- LIBRARY GRID -->

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <TextView
                    style="@style/QuestRollMenuItem"
                    android:onClick="openItemListActivity"
                    android:text="Items"/>

                <TextView
                    style="@style/QuestRollMenuItem"
                    android:onClick="openItemSetListActivity"
                    android:text="Item Sets"/>

                <TextView
                    style="@style/QuestRollMenuItem"
                    android:onClick="openConditionListActivity"
                    android:text="Conditions"/>

                <TextView
                    style="@style/QuestRollMenuItem"
                    android:onClick="openRulesetListActivity"
                    android:text="Rulesets"/>

                <TextView
                    style="@style/QuestRollMenuItem"
                    android:onClick="openCreatureListActivity"
                    android:text="Creatures"/>

                <TextView
                    style="@style/QuestRollMenuItem"
                    android:onClick="openDamageTypeListActivity"
                    android:text="Damage Types"/>

            </GridLayout>

            <!-- TOOLS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="TOOLS"
                android:textColor="#D4AF37"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnManageData"
                style="@style/QuestRollMenuItem"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:onClick="openManageData"
                android:text="Manage API Data"/>

        </LinearLayout>
        ```

    </ScrollView>

    ```

</FrameLayout>
