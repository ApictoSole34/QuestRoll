<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/QuestRollTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose game system"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/game_system_radio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/radio_5e_2014"
            style="@style/QuestRollBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D&amp;D 5e (2014 Rules)" />

    </RadioGroup>

    <Button
        android:id="@+id/next_button"
        style="@style/QuestRollButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Next" />

</LinearLayout>