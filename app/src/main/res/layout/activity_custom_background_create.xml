<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/threads_dark">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/QuestRollHeaderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CREATE BACKGROUND"
                android:layout_marginBottom="16dp" />

            <!-- Core Details -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Background Name"
                style="@style/QuestRollInputLayout"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/threads_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Description"
                style="@style/QuestRollInputLayout"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/threads_text_primary"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/QuestRollCaption" android:text="Game System" android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/spinnerGameSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/threads_gold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Starting Gold"
                style="@style/QuestRollInputLayout"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStartingGold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/threads_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Equipment Section -->
            <TextView style="@style/QuestRollSectionHeader" android:text="Equipment" android:layout_marginTop="16dp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Equipment Description"
                style="@style/QuestRollInputLayout"
                android:layout_marginBottom="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEquipmentDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/threads_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddEquipment"
                style="@style/QuestRollButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Equipment" />

            <!-- Languages Section -->
            <TextView style="@style/QuestRollSectionHeader" android:text="Languages" android:layout_marginTop="16dp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Languages Description"
                style="@style/QuestRollInputLayout"
                android:layout_marginBottom="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLanguagesDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/threads_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Language Choices (Count)"
                style="@style/QuestRollInputLayout"
                android:layout_marginBottom="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLanguageChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/threads_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddLanguage"
                style="@style/QuestRollButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Language" />

            <!-- Proficiencies -->
            <TextView style="@style/QuestRollSectionHeader" android:text="Skill Proficiencies" android:layout_marginTop="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSkillProficiencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddSkill"
                style="@style/QuestRollButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Skill" />

            <TextView style="@style/QuestRollSectionHeader" android:text="Tool Proficiencies" android:layout_marginTop="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvToolProficiencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTool"
                style="@style/QuestRollButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Tool" />

            <!-- Features -->
            <TextView style="@style/QuestRollSectionHeader" android:text="Features" android:layout_marginTop="16dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFeature"
                style="@style/QuestRollButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Feature" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/QuestRollButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Background"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
