<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/QuestRollSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subclass Info"
        android:layout_marginBottom="16dp" />

    <TextView
        style="@style/QuestRollCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="If this is a subclass, select the parent class"
        android:layout_marginBottom="16dp" />

    <CheckBox
        android:id="@+id/cb_is_subclass"
        style="@style/QuestRollBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is a subclass"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/parent_class_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/QuestRollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parent Class"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_parent_class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>