<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/character_full_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:adjustViewBounds="true"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text" />

        <TextView
            android:id="@+id/character_name"
            style="@style/QuestRollTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/character_species"
            style="@style/QuestRollBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Race: -" />

        <TextView
            android:id="@+id/character_classes"
            style="@style/QuestRollBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classes: -" />

        <TextView
            android:id="@+id/character_alignment"
            style="@style/QuestRollBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alignment: -" />

        <TextView
            android:id="@+id/character_background"
            style="@style/QuestRollBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Background: -" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/hp_text"
                style="@style/QuestRollBody"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="HP: ?" />

            <TextView
                android:id="@+id/ac_text"
                style="@style/QuestRollBody"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="AC: ?" />

            <TextView
                android:id="@+id/initiative_text"
                style="@style/QuestRollBody"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Initiative: ?" />

            <TextView
                android:id="@+id/proficiency_text"
                style="@style/QuestRollBody"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Prof. bonus: ?" />

        </LinearLayout>

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attributes"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/attributes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skills"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/skills_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Languages"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/languages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Traits"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/traits_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inventory"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/inventory_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spells"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/spells_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_edit"
                style="@style/QuestRollButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_delete"
                style="@style/QuestRollButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:backgroundTint="@android:color/holo_red_dark" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>