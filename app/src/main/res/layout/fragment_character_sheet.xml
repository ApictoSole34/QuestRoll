<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/threads_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/threads_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/character_full_image"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:civ_border_color="@color/threads_gold"
                    app:civ_border_width="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/character_name"
                        style="@style/QuestRollTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Character Name"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/character_classes"
                        style="@style/QuestRollBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Class Level"
                        android:textColor="@color/threads_gold" />

                    <TextView
                        android:id="@+id/character_species"
                        style="@style/QuestRollCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Race" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- VITALS SECTION (HP, AC, INIT) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                app:cardBackgroundColor="@color/threads_surface"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/QuestRollSectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hit Points"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/hp_text"
                        style="@style/QuestRollTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 0"
                        android:textSize="24sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/threads_surface"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ac_text"
                            style="@style/QuestRollStat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10" />

                        <TextView
                            style="@style/QuestRollCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AC" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/threads_surface"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/initiative_text"
                            style="@style/QuestRollStat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0" />

                        <TextView
                            style="@style/QuestRollCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Init" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- ATTRIBUTES SECTION -->
        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Attributes" />

        <LinearLayout
            android:id="@+id/attributes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/threads_surface"
            android:orientation="vertical"
            android:padding="8dp" />

        <!-- SAVING THROWS & SKILLS SECTION -->
        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Saving Throws" />

        <LinearLayout
            android:id="@+id/saving_throws_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/threads_surface"
            android:orientation="vertical"
            android:padding="8dp" />

        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Skills" />

        <LinearLayout
            android:id="@+id/skills_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/threads_surface"
            android:orientation="vertical"
            android:padding="8dp" />

        <!-- TRAITS SECTION -->
        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Traits" />

        <LinearLayout
            android:id="@+id/traits_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/threads_surface"
            android:orientation="vertical"
            android:padding="8dp" />

        <!-- INVENTORY SECTION -->
        <TextView
            style="@style/QuestRollSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Inventory" />

        <LinearLayout
            android:id="@+id/inventory_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@color/threads_surface"
            android:orientation="vertical"
            android:padding="8dp" />

        <!-- ACTION BUTTONS -->
        <Button
            android:id="@+id/btn_export_pdf"
            style="@style/QuestRollButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Export to PDF" />

        <Button
            android:id="@+id/btn_delete"
            style="@style/QuestRollButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Character"
            app:backgroundTint="@color/threads_hp_red" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
