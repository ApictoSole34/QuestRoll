<?xml version="1.0" encoding="utf-8"?>

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#25D4AF37">

    <item>

        <shape android:shape="rectangle">

            <solid
                android:color="#1A000000" />

            <stroke
                android:width="1dp"
                android:color="#35D4AF37" />

            <corners
                android:radius="18dp" />

            <padding
                android:left="20dp"
                android:top="12dp"
                android:right="20dp"
                android:bottom="12dp" />

        </shape>

    </item>

</ripple>