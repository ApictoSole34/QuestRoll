    <color name="colorAccent">@color/threads_gold</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="outline">@color/threads_border</color>
    <color name="darker_gray">@color/threads_text_secondary</color>

