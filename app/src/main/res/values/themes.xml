<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="colorOutline" format="color" />

    <style name="Theme.QuestRoll" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorOutline">@color/outline</item>
    </style>

    <style name="QuestRollButton" parent="@android:style/Widget.Button">
        <item name="android:textColor">#E8D7A8</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/fantasy_button</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="QuestRollMenuItem">

        <item name="android:background">@drawable/fantasy_button</item>

        <item name="android:textColor">#D8D3C5</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>

        <item name="android:gravity">center_vertical</item>

        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>

    </style>

    <style name="Widget.QuestRoll.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/threads_gold</item>
        <item name="tint">@color/threads_dark</item>
        <item name="elevation">4dp</item>
    </style>
</resources>